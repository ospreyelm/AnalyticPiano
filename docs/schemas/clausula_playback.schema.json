{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clausula_playback",
  "title": "Clausula Exercise — playback mode (Branch B)",
  "description": "Branch B clausula playback exercise. Structurally identical to umto_chorale playback — same type/mode values, same UMTO shape inside score.umto. Distinguished from Branch A Bach-chorale exercises solely by skill tags (branch_b, clausula_*). Student sees a short cadential formula (2–4 voices) and plays it note by note on MIDI. Generated by generate_clausulae_b1 from Z7 arithmetic enumeration in clausulae/core.py and clausulae/generate.py.",
  "type": "object",
  "required": ["type", "mode", "isUMTO", "clef", "key", "meter", "grading", "score"],
  "properties": {
    "type":    { "const": "umto_chorale" },
    "mode":    { "const": "playback" },
    "isUMTO": { "const": true },
    "exerciseId": { "type": "string", "examples": ["EB58BM"] },
    "clef": {
      "type": "string",
      "enum": ["treble", "bass", "keyboard"],
      "description": "Single-voice clausulae use 'treble' or 'bass'. Multi-voice use 'keyboard'."
    },
    "key":   { "type": "string", "description": "Key of the clausula realization.", "examples": ["jC_", "jG_"] },
    "meter": {
      "type": "string",
      "description": "Always '2/2' (alla breve) for clausula exercises — matches the ANT–PEN–ULT rhythmic grid.",
      "const": "2/2"
    },
    "complexity_score": { "type": "integer", "minimum": 1, "maximum": 12 },
    "introText":  { "type": "string" },
    "reviewText": { "type": "string" },
    "grading": {
      "type": "array",
      "description": "One GradingSlice per clausula step (ANT, PEN, ULT). Simple cadences have 3 slices. Compound cadences may have 4–5 (including the π passing note at offset 0.5).",
      "items": {
        "type": "object",
        "required": ["offset", "target_midi_pitches"],
        "properties": {
          "offset": {
            "type": "number",
            "description": "Quarter-lengths from start. ANT=0.0, (π=0.5 compound only), PEN=2.0, ULT=4.0 in 2/2.",
            "examples": [0.0, 0.5, 2.0, 4.0]
          },
          "target_midi_pitches": {
            "type": "array",
            "items": { "type": "integer", "minimum": 0, "maximum": 127 },
            "description": "MIDI pitches for all voices at this clausula step. Multi-voice exercises have multiple pitches per slice."
          },
          "rhythmic_flexibility": { "type": "boolean", "default": false }
        }
      },
      "minItems": 3,
      "maxItems": 5
    },
    "score": {
      "type": "object",
      "required": ["umto"],
      "properties": {
        "meta":     { "type": "object" },
        "measures": { "type": "array" },
        "umto": {
          "type": "object",
          "description": "Canonical UMTO payload for this clausula exercise.",
          "required": ["metadata", "voices", "analysis", "grading"],
          "properties": {
            "metadata": {
              "type": "object",
              "properties": {
                "exercise_id": { "type": "string" },
                "source": {
                  "type": "string",
                  "description": "Human-readable clausula description.",
                  "examples": ["B1 — Discant clausula (Do–Ti–Do) in C"]
                },
                "key":    { "type": "string" },
                "meter":  { "const": "2/2" },
                "clef":   { "type": "string" },
                "mode":   { "const": "playback" },
                "complexity_score": { "type": "integer" }
              }
            },
            "voices": {
              "type": "object",
              "description": "SATB voice streams encoding the clausula triple(s). Each voice is a sequence of 2–4 note events (ANT, [π], PEN, ULT). Unused voices are empty arrays.",
              "properties": {
                "S": {
                  "type": "array",
                  "description": "Soprano (Discant clausula — Do–Ti–Do). Present in single-voice exercises.",
                  "items": { "$ref": "#/$defs/ClausulaVoiceEvent" }
                },
                "A": {
                  "type": "array",
                  "description": "Alto clausula (Sol–Fa–Mi, Sol–Sol–Sol, Sol–La–Sol). Empty in single-voice exercises.",
                  "items": { "$ref": "#/$defs/ClausulaVoiceEvent" }
                },
                "T": {
                  "type": "array",
                  "description": "Tenor clausula (Do/Mi ↔ Re ↔ Do/Mi). Empty in single-voice exercises.",
                  "items": { "$ref": "#/$defs/ClausulaVoiceEvent" }
                },
                "B": {
                  "type": "array",
                  "description": "Bass clausula (Do–Sol–Do). Empty in treble-only exercises.",
                  "items": { "$ref": "#/$defs/ClausulaVoiceEvent" }
                }
              }
            },
            "analysis": {
              "type": "array",
              "description": "Analysis slices present but content fields are empty (no functional_label, roman_numeral, etc.) for pure playback clausula exercises. Will be populated with is_target:true slices in the planned roman_from_clausulae variant.",
              "items": {
                "type": "object",
                "properties": {
                  "offset":    { "type": "number" },
                  "content": {
                    "type": "object",
                    "description": "All content fields are null/empty for playback-only clausula exercises.",
                    "properties": {
                      "roman_numeral":    { "type": ["string","null"] },
                      "figured_bass":     { "type": ["string","null"] },
                      "functional_label": { "type": ["string","null"] },
                      "scale_degrees":    { "type": ["array","null"] }
                    }
                  },
                  "is_target": { "const": false },
                  "unit_tags": { "type": "array", "items": { "type": "integer" } }
                }
              }
            },
            "grading": { "type": "array" }
          }
        }
      }
    }
  },

  "x-skill-tags": {
    "description": "Clausula exercises are identified by skill tags on Exercise.skill_tags, not by type/mode alone.",
    "required": ["branch_b"],
    "pattern": {
      "branch":         "branch_b (always present)",
      "unit":           "unit:B1, unit:B2, ... (Branch B curriculum unit)",
      "clausula_type":  "clausula_discant | clausula_tenor | clausula_alto | clausula_bass",
      "clausula_var":   "clausula_var0 | clausula_var1 | ... (variant index within type)"
    }
  },

  "x-clausula-math": {
    "description": "All clausula logic uses Z7 arithmetic — diatonic scale degrees 0–6 (0=Do, 1=Re, 2=Mi, 3=Fa, 4=Sol, 5=La, 6=Ti). No chromatic alterations at this layer; realized to actual pitches during generation.",
    "types": {
      "Discant": { "triples": [[0,6,0]],                             "color": "#F9141B" },
      "Tenor":   { "triples": [[0,1,0],[0,1,2],[2,1,0],[2,1,2]],     "color": "#108040" },
      "Alto":    { "triples": [[4,4,4],[4,3,2],[4,5,4]],             "color": "#1B4FD8" },
      "Bass":    { "triples": [[0,4,0]],                             "color": "#1A1B1E" }
    },
    "cadence_types": {
      "simple":   "All voices move simultaneously. τ=0 for all voices.",
      "compound": "Late voice (Discant, τ=1) enters half-beat after early voices, creating suspension at PEN. π (passing note) at beat 0.5 consonant with early ANT."
    },
    "validation": "clausulae/constraints.py: consonant_vertical, parallel_perfect, distinctness_ok, bass_constraint_ok"
  },

  "$defs": {
    "ClausulaVoiceEvent": {
      "type": "object",
      "required": ["kind", "duration", "duration_type"],
      "description": "One note in the clausula triple sequence (ANT, [π], PEN, ULT).",
      "properties": {
        "kind": { "const": "note" },
        "pitch": {
          "type": "object",
          "required": ["step","alter","octave","midi"],
          "properties": {
            "step":   { "type": "string", "enum": ["A","B","C","D","E","F","G"] },
            "alter":  { "type": "integer", "minimum": -2, "maximum": 2 },
            "octave": { "type": "integer" },
            "midi":   { "type": "integer" }
          }
        },
        "duration": {
          "type": "number",
          "description": "In 2/2: ANT=2.0 (half), PEN=2.0 (half), ULT=4.0 (whole). π=1.0 (quarter) in compound clausulae.",
          "enum": [1.0, 2.0, 4.0]
        },
        "duration_type": {
          "type": "string",
          "enum": ["h", "q", "w"],
          "description": "h=half (ANT/PEN in 2/2), w=whole (ULT in 2/2), q=quarter (π in compound)."
        },
        "dots":          { "type": "integer", "const": 0 },
        "is_tied_start": { "type": "boolean", "default": false },
        "is_tied_stop":  { "type": "boolean", "default": false },
        "is_target":     { "type": "boolean", "default": true }
      }
    }
  },

  "examples": [
    {
      "type": "umto_chorale",
      "mode": "playback",
      "isUMTO": true,
      "exerciseId": "EB58BM",
      "clef": "treble",
      "key": "jC_",
      "meter": "2/2",
      "complexity_score": 1,
      "grading": [
        { "offset": 0.0, "target_midi_pitches": [72], "rhythmic_flexibility": false },
        { "offset": 2.0, "target_midi_pitches": [71], "rhythmic_flexibility": false },
        { "offset": 4.0, "target_midi_pitches": [72], "rhythmic_flexibility": false }
      ],
      "score": {
        "umto": {
          "metadata": {
            "exercise_id": "EB58BM",
            "source": "B1 — Discant clausula (Do–Ti–Do) in C",
            "key": "jC_", "meter": "2/2", "clef": "treble", "mode": "playback",
            "complexity_score": 1, "is_umto": true
          },
          "voices": {
            "S": [
              { "kind": "note", "pitch": { "step": "C", "alter": 0, "octave": 5, "midi": 72 }, "duration": 2.0, "duration_type": "h", "dots": 0, "is_tied_start": false, "is_tied_stop": false, "is_target": true },
              { "kind": "note", "pitch": { "step": "B", "alter": 0, "octave": 4, "midi": 71 }, "duration": 2.0, "duration_type": "h", "dots": 0, "is_tied_start": false, "is_tied_stop": false, "is_target": true },
              { "kind": "note", "pitch": { "step": "C", "alter": 0, "octave": 5, "midi": 72 }, "duration": 4.0, "duration_type": "w", "dots": 0, "is_tied_start": false, "is_tied_stop": false, "is_target": true }
            ],
            "A": [], "T": [], "B": []
          },
          "analysis": [
            { "offset": 0.0, "content": { "roman_numeral": null, "figured_bass": null, "functional_label": "" }, "is_target": false, "unit_tags": [] },
            { "offset": 2.0, "content": { "roman_numeral": null, "figured_bass": null, "functional_label": "" }, "is_target": false, "unit_tags": [] },
            { "offset": 4.0, "content": { "roman_numeral": null, "figured_bass": null, "functional_label": "" }, "is_target": false, "unit_tags": [] }
          ],
          "grading": [
            { "offset": 0.0, "target_midi_pitches": [72], "rhythmic_flexibility": false },
            { "offset": 2.0, "target_midi_pitches": [71], "rhythmic_flexibility": false },
            { "offset": 4.0, "target_midi_pitches": [72], "rhythmic_flexibility": false }
          ]
        }
      }
    }
  ]
}
