   <direction>
    <direction-type>
     <words default-x="133" default-y="170" justify="left" valign="middle" font-family="Adobe Garamond Pro" font-style="normal" font-size="9.939" font-weight="normal">Perfect 5ths may move to dim. 5ths.</words>
     <words justify="left" valign="middle" font-family="Adobe Garamond Pro" font-style="normal" font-size="9.939" font-weight="normal">But dim. 5ths are a dissonance and need</words>
     <words justify="left" valign="middle" font-family="Adobe Garamond Pro" font-style="normal" font-size="9.939" font-weight="normal">to resolve to a third. Thus, dim. 5ths</words>
     <words justify="left" valign="middle" font-family="Adobe Garamond Pro" font-style="normal" font-size="9.939" font-weight="normal">do not usually progress to perfect 5ths,</words>
     <words justify="left" valign="middle" font-family="Adobe Garamond Pro" font-style="normal" font-size="9.939" font-weight="normal">but this is nevertheless allowable if</words>
     <words justify="left" valign="middle" font-family="Adobe Garamond Pro" font-style="normal" font-size="9.939" font-weight="normal">(1) it is not in the outer voices and</words>
     <words justify="left" valign="middle" font-family="Adobe Garamond Pro" font-style="normal" font-size="9.939" font-weight="normal">(2) there are three or more voices.</words>
    </direction-type>
    <offset sound="no">1023</offset>
    <voice>8</voice>
    <staff>6</staff>
   </direction>
